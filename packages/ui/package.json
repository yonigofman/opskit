{
  "name": "@opskit/ui",
  "version": "0.1.0",
  "description": "OpsKit's shadcn-native components and the OpenUI library agents render them through. Distributed as a shadcn registry; consumed from source inside this repo.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./opskit.css": "./src/styles/opskit.css",
    "./shadcn-nova.css": "./src/styles/shadcn-nova.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prompt": "OPSKIT_PRINT_PROMPT=1 vitest run test/prompt.test.ts --silent=false --reporter=verbose"
  },
  "dependencies": {
    "@opskit/core": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "radix-ui": "1.8.1",
    "tailwind-merge": "3.7.0",
    "uplot": "1.6.32"
  },
  "peerDependencies": {
    "@openuidev/react-lang": "^1.0.1",
    "react": ">=18",
    "react-dom": ">=18",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@openuidev/react-lang": "1.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "jsdom": "27.0.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  }
}
