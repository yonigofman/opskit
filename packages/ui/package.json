{
  "name": "@opskit/ui",
  "version": "0.1.0",
  "description": "Styled OpsKit components and the OpenUI library agents render them through.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./opskit.css": "./src/styles/opskit.css"
  },
  "files": ["dist", "src/styles", "registry.json"],
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opskit/core": "workspace:*",
    "uplot": "1.6.32"
  },
  "peerDependencies": {
    "@openuidev/react-lang": "^1.0.1",
    "react": ">=18",
    "react-dom": ">=18",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@openuidev/react-lang": "1.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "jsdom": "27.0.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  }
}
