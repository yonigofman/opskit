  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.1.13",
    "jsdom": "27.0.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  }
}
