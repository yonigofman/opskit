{
  "name": "@opskit/core",
  "version": "0.1.0",
  "description": "Headless core of OpsKit: Gateway client, live data hooks and the component contract agents render.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
